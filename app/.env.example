# The One — environment example
#
# Copy to `.env` (same folder) and fill in. `.env` is gitignored; this file is not,
# so never put a real secret here.

# ── Authentication ──────────────────────────────────────────────────────────
# Two mutually exclusive modes. The API refuses to boot with neither.

# MODE A · Microsoft Entra ID (what production uses).
# Create an app registration at entra.microsoft.com → App registrations → New.
# Who gets in: anyone on AUTH_ALLOWED_DOMAINS enrols themselves on first sign-in
# as AUTH_AUTO_ENROL_ROLE (change their role afterwards in Admin › Users);
# anyone else needs a user row created from Admin › Users first (an invitation).
#ENTRA_TENANT_ID=00000000-0000-0000-0000-000000000000
#ENTRA_CLIENT_ID=00000000-0000-0000-0000-000000000000
#ENTRA_CLIENT_SECRET=
# Must match a "Web" redirect URI on the app registration, character for character.
#ENTRA_REDIRECT_URI=http://localhost:5173/api/auth/callback
# Comma-separated email domains that may sign in without an invitation
# (default byblosvista.com; "none" = strictly invite-only).
#AUTH_ALLOWED_DOMAINS=byblosvista.com
# Role code a self-enrolled account starts with (default om_probation).
#AUTH_AUTO_ENROL_ROLE=om_probation

# MODE B · Local development bypass.
# Pick any seeded user from a list, no password, no Microsoft. The API REFUSES
# TO START if this is true while NODE_ENV=production.
AUTH_DEV_BYPASS=true

# Hours a session cookie stays valid.
SESSION_TTL_HOURS=12

# Where the browser lives. Used to redirect back after the Entra round trip, and
# to decide whether the session cookie gets the Secure flag (https → yes).
WEB_ORIGIN=http://localhost:5173

# ── Ecotrak transitions (rules 2.6.3 / 2.7) ─────────────────────────────────
# What a status change does when the current Ecotrak status would not allow the
# transition it implies. warn (default): the move goes through and the audit row
# says Ecotrak would refuse it. block: the move is refused with a 409. Nothing
# is written to Ecotrak in either mode.
#ECOTRAK_TRANSITION_MODE=warn

# ── Servers ─────────────────────────────────────────────────────────────────
API_PORT=5174
API_HOST=127.0.0.1
WEB_PORT=5173

# ── Database ────────────────────────────────────────────────────────────────
# Unused today: the prototype runs embedded PGlite, persisted at
# packages/db/pgdata. This is the Postgres-16 upgrade path (docker-compose.yml).
#DATABASE_URL=postgres://theone:theone@localhost:5432/theone
