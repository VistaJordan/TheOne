# The One — environment example (S1 prototype)
# S1 uses embedded PGlite (filesystem-persisted at packages/db/pgdata); no DB URL required.
# The DATABASE_URL below is the unused Postgres-16 upgrade path (docker-compose.yml).
DATABASE_URL=postgres://theone:theone@localhost:5432/theone

# API server port
API_PORT=5174

# Web dev server port (Vite)
WEB_PORT=5173
