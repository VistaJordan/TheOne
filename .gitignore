# --- Brainstorming folders (reference material, not part of the codebase) ---
/Support Automation/
/Quo X Quote Builder/
/Inbox Monitor/

# --- Secrets: never commit credentials ---
.env
.env.*
!.env.example

# --- Dependencies & build artifacts ---
node_modules/
dist/
.next/
.vercel/
*.tsbuildinfo

# --- Local database & caches ---
pgdata/
.npm-cache/
*.log

# --- OS noise ---
Thumbs.db
.DS_Store

# Root has a scripts-only package.json (a shim to app/); an `npm install` here
# would only write an empty lockfile.
/package-lock.json

# Vercel build artifact (scripts/bundle-api.mjs output)
app/api/_bundle.cjs
.vercel
